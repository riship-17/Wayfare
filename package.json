{
  "name": "wayfare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server --",
    "import-transit": "npm run import-transit -w server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w packages/shared && npm run test -w server && npm run test -w client",
    "e2e": "npm run e2e -w client",
    "build:demo": "VITE_STATIC_DEMO=true npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "latest",
    "typescript": "latest"
  }
}