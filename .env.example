# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wayfare
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
# Public base URL used in share links and og tags
PUBLIC_URL=http://localhost:5173
# Contact for the landing page "Partner with us" link
CONTACT_EMAIL={{contact_email}}
# Email domain students must use to join the Heriot-Watt Dubai group
HW_EMAIL_DOMAIN={{hw_email_domain}}

# Demo accounts (only created and usable when DEMO_MODE=true)
DEMO_MODE=true
DEMO_STUDENT_EMAIL=aanya.demo@wayfare.app
DEMO_STUDENT_PASSWORD=change-me-demo-student
DEMO_ADMIN_EMAIL=housing.demo@wayfare.app
DEMO_ADMIN_PASSWORD=change-me-demo-admin
